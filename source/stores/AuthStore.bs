' AuthStore — the current session, persisted locally.
'
' Two session modes: a local "guest" session (no transport, no network call, no
' authKey — the app simply runs without an account, so nothing syncs), and a
' "stremio" session that carries the account authKey + user profile (link-code
' pairing and the account sync live in later stages). The session survives
' relaunches through the "session" key of the "auth" registry section, so
' MainScene can skip the auth screen when IsLoggedIn() is true.

class AuthStore
    registry as dynamic
    session as string
    authKey as string
    user as dynamic
    dirty as boolean
    scopeHash as dynamic

    sub new(registry = invalid as dynamic, scopeHash = invalid as dynamic)
        m.registry = registry
        m.session = ""
        m.authKey = ""
        m.user = invalid
        m.dirty = false
        m.scopeHash = scopeHash
        m.Load()
    end sub

    ' Sign in without an account. Drops any previous account data so a guest
    ' session never carries a stale authKey or profile.
    function LoginGuest() as object
        m.session = "guest"
        m.authKey = ""
        m.user = invalid
        persisted = m.Save()
        return { ok: true, session: m.session, persisted:persisted }
    end function

    ' Sign in to a Stremio account with a paired authKey and its user profile.
    function LoginStremio(authKey as string, user as dynamic) as object
        m.session = "stremio"
        m.authKey = authKey
        m.user = user
        persisted = m.Save()
        return { ok: true, session: m.session, authKey: m.authKey, persisted:persisted }
    end function

    function GetSession() as string
        return m.session
    end function

    function GetAuthKey() as string
        return m.authKey
    end function

    function GetUser() as dynamic
        return m.user
    end function

    function IsLoggedIn() as boolean
        return m.session <> ""
    end function

    sub Logout()
        m.session = ""
        m.authKey = ""
        m.user = invalid
        m.Save()
    end sub

    function GetCacheScope() as string
        if m.session <> "stremio" or m.authKey = "" then return ""
        identity = "session:" + m.authKey
        if Type(m.user) = "roAssociativeArray"
            id = m.user._id
            if id = invalid then id = m.user.id
            if GetInterface(id,"ifString") <> invalid and id <> "" then identity = "account:" + id
        end if
        try
            if m.scopeHash <> invalid
                value = m.scopeHash(identity)
                if GetInterface(value,"ifString") <> invalid and CreateObject("roRegex","^[0-9a-f]{64}$", "").IsMatch(value) then return value
                return ""
            end if
            bytes = CreateObject("roByteArray")
            bytes.FromAsciiString(identity)
            digest = CreateObject("roEVPDigest")
            if digest.Setup("sha256") <> 0 then return ""
            value = LCase(digest.Process(bytes))
            if CreateObject("roRegex","^[0-9a-f]{64}$", "").IsMatch(value) then return value
            return ""
        catch e
            return ""
        end try
    end function

    function SaveFailed() as boolean
        return m.dirty
    end function

    function Save() as boolean
        m.dirty = true
        if m.registry = invalid then return false
        data = { session: m.session, authKey: m.authKey }
        if m.user <> invalid then data.user = m.user
        written = m.registry.Write("session", FormatJson(data)) = true
        committed = m.registry.Flush() = true
        m.dirty = not (written and committed)
        return not m.dirty
    end function

    sub Load()
        if m.registry = invalid then return
        raw = m.registry.Read("session")
        if raw = "" then return
        ' The Roku runtime throws on malformed JSON rather than returning
        ' invalid (see Transport.Parse); a corrupt session key must mean "no
        ' session", not a cold-start crash.
        parsed = invalid
        try
            parsed = ParseJson(raw)
        catch e
            return
        end try
        if Type(parsed) <> "roAssociativeArray" then return
        if parsed.session = "guest" then m.session = "guest"
        if parsed.session = "stremio" and GetInterface(parsed.authKey,"ifString") <> invalid and parsed.authKey <> ""
            m.session = "stremio"
            m.authKey = parsed.authKey
        end if
        if parsed.user <> invalid then m.user = parsed.user
    end sub
end class
