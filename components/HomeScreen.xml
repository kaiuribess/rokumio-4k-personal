<?xml version="1.0" encoding="utf-8"?>
<component name="HomeScreen" extends="Screen">
    <interface>
        <!-- The one action Home reports upward: a push request. The Scene
             observes it and calls ScreenStack.push with a target + params. -->
        <field id="pushRequest" type="assocarray" alwaysNotify="true" />

        <!-- Screen contract: called by ScreenStack for show/hide/focus/back.
             callFunc only runs for functions declared in the interface. Stores
             are class instances and cannot cross components through a field,
             so they arrive via callFunc. -->
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <function name="RebuildRows" />
        <function name="EnsureCurrentRows" />
        <function name="RefreshContinueWatching" />
    </interface>

    <script type="text/brightscript" uri="pkg:/source/util/MetadataOrigin.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/ProviderPriority.brs" />
    <script type="text/brightscript" uri="pkg:/components/HomeScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/HomeCinema.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/HomeCatalogPolicy.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/TimerGuard.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/TileSize.bs" />

    <children>
        <Rectangle id="homeBg" width="1920" height="1080" color="0x0" />
        <Label
            id="homeTitle"
            translation="[260, 48]"
            width="1580"
            height="70"
            text="Crimson Cinema"
            font="font:LargeBoldSystemFont" />
        <Label
            id="homeSub"
            translation="[260, 118]"
            width="1580"
            height="40"
            text="Find your next movie or show"
            font="font:SmallSystemFont" />

        <Label id="homeCatalogStatus" translation="[260, 570]" width="1580" height="32"
            font="font:SmallSystemFont" />

        <Group id="homeHeroPanel" translation="[260, 164]">
            <Rectangle id="homeHeroFace" width="1580" height="274" />
            <Poster id="homeHeroArt" translation="[940, 0]" width="640" height="274" loadWidth="640" loadHeight="274" loadDisplayMode="scaleToZoom" loadSync="false" />
            <Poster id="homeHeroMark" uri="pkg:/images/crimson-mark.png" translation="[1180, 60]" width="150" height="150" loadWidth="150" loadHeight="150" />
            <Rectangle id="homeHeroAccent" translation="[0, 0]" width="6" height="274" />
            <Label id="homeHeroTitle" translation="[36, 24]" width="868" height="98" wrap="true" maxLines="2" font="font:LargeBoldSystemFont" />
            <Label id="homeHeroInfo" translation="[36, 126]" width="868" height="32" font="font:SmallSystemFont" />
            <Label id="homeHeroOverview" translation="[36, 166]" width="868" height="88" wrap="true" maxLines="3">
                <Font role="font" uri="pkg:/fonts/OpenSans-Regular.ttf" size="24" />
            </Label>
        </Group>
        <RowList id="homeQuick" translation="[260, 462]" numRows="1" itemSize="[1580, 84]" rowItemSize="[[304, 80]]" rowItemSpacing="[[12, 0]]" showRowLabel="[false]" drawFocusFeedback="false" itemComponentName="HomeQuickTile" />
        <Timer id="homeHeroDelay" duration="0.25" repeat="false" />

        <!-- Left rail: the vertical icon menu (Search, Discover, Library,
             Add-ons, Settings, About). A one-column RowList of RailTiles; OK
             on an icon publishes a pushRequest the Scene routes. Focus reaches
             it from the grid via Left/Right. -->
        <Rectangle id="railBg" translation="[60, 0]" width="170" height="1080"/>
        <Poster uri="pkg:/images/crimson-mark.png" translation="[100, 76]" width="90" height="90" />
        <RowList
            id="rail"
            translation="[80, 300]"
            numRows="6"
            itemSize="[140, 100]"
            itemSpacing="[0, 12]"
            rowItemSize="[[140, 100]]"
            focusXOffset="[0]"
            rowItemSpacing="[[0, 0]]"
            showRowLabel="[false]"
            drawFocusFeedback="false"
            itemComponentName="RailTile"
            vertFocusAnimationStyle="floatingFocus"/>

        <!-- Poster rows: a single RowList owns the whole grid physics (vertical
             row scrolling/clipping, horizontal per-row tiles, row labels). Each
             item renders as a PosterTile component. Content is set in code. -->
        <RowList
            id="catalog"
            translation="[260, 628]"
            numRows="1"
            itemSize="[1580, 324]"
            itemSpacing="[0, 64]"
            rowItemSize="[[216, 324]]"
            rowItemSpacing="[[18, 0]]"
            showRowLabel="[true]"
            rowLabelFont="font:MediumBoldSystemFont"
            drawFocusFeedback="true"
            itemComponentName="PosterTile" />
        <Rectangle id="homeQualityPlate" translation="[1510, 60]" width="310" height="44">
            <Label id="homeQualityLabel" text="4K  /  1080p" translation="[10, 6]" width="290" height="32"
                horizAlign="center" font="font:SmallBoldSystemFont" />
        </Rectangle>
        <Label id="homeHelp" translation="[260, 1004]" width="1580" height="44"
            text="OK  Open     *  Menu / shortcuts     Play/Pause  Refresh"
            font="font:SmallSystemFont" />
    </children>
</component>
