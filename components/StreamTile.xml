<?xml version="1.0" encoding="utf-8"?>
<component name="StreamTile" extends="Group">
    <!-- Wide stream card for StreamsScreen's list. RowList feeds each item its
         ContentNode through itemContent (title + description â€” real Content
         Meta-Data fields, unlike subtitle). The tile splits the multi-line
         description at its line feeds itself, so it can show as many lines as
         the title actually carries. Focus drives through itemHasFocus /
         rowHasFocus. -->
    <interface>
        <field id="itemContent" type="node" />
        <field id="itemHasFocus" type="boolean" />
        <field id="rowHasFocus" type="boolean" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/StreamTile.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />

    <children>
        <!-- tileBorder is the frame, tileFace the inset face so focus draws a
             real mint frame instead of painting over the card. -->
        <Rectangle id="tileBorder" width="1080" height="210">
            <Rectangle id="tileFace" width="1072" height="202" translation="[4, 4]" />
            <Label id="tileQuality" translation="[18, 12]" width="1022" height="30"
                font="font:SmallBoldSystemFont" />
            <!-- The title never scrolls, so it sits outside the clip and simply
                 truncates with an ellipsis when it is too long (width lets
                 EmojiLabel do the truncating). -->
            <EmojiLabel
                id="tileTitle"
                width="1022"
                height="40"
                translation="[18, 50]"
                vertAlign="center" />
            <!-- cardClip is the window and never moves. cardContent is the
                 payload and is the only node that translates: sliding it is what
                 brings the tail of an overflowing line into view. Clipping the
                 payload itself would drag the window along with the text and
                 show the same slice forever. -->
            <Group id="cardClip" clippingRect="[0, 98, 1022, 108]">
                <Group id="cardContent">
                    <EmojiLabel
                        id="tileLine1"
                        height="34"
                        translation="[18, 100]"
                        vertAlign="center" />
                    <EmojiLabel
                        id="tileLine2"
                        height="34"
                        translation="[18, 138]"
                        vertAlign="center" />
                    <EmojiLabel
                        id="tileLine3"
                        height="34"
                        translation="[18, 176]"
                        vertAlign="center" />
                    <EmojiLabel
                        id="tileLine4"
                        height="34"
                        translation="[18, 214]"
                        vertAlign="center" />
                    <EmojiLabel
                        id="tileLine5"
                        height="34"
                        translation="[18, 252]"
                        vertAlign="center" />
                </Group>
            </Group>
            <Timer
                id="measureTimer"
                duration="0.05"
                repeat="false"
                control="stop" />
            <!-- The slide itself. duration must match m.interval in
                 StreamTile.brs: the tick counter turns seconds into ticks. -->
            <Timer
                id="scrollTimer"
                duration="0.03"
                repeat="true"
                control="stop" />
        </Rectangle>
    </children>
</component>
