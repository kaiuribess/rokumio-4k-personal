<?xml version="1.0" encoding="utf-8"?>
<component name="SettingsScreen" extends="Screen">
    <!-- Optional account sync and advanced external-server setup. The direct
         HTTPS playback route needs no external streaming server. -->
    <interface>
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <field id="pushRequest" type="assocarray" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/SettingsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />
    <script type="text/brightscript" uri="pkg:/source/util/AudioCapabilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/AudioSetup.brs" />
    <script type="text/brightscript" uri="pkg:/components/SettingsAudio.brs" />

    <children>
        <Rectangle id="settingsBg" width="1920" height="1080" color="0x0" />

        <Label
            id="settingsTitle"
            translation="[80, 48]"
            width="1760"
            height="70"
            text="Settings"
            font="font:LargeBoldSystemFont" />
        <Label
            id="settingsSub"
            translation="[80, 128]"
            width="1760"
            height="40"
            text="OK opens an option Â· Back returns to Home"
            font="font:SmallSystemFont" />

        <RowList
            id="settingsList"
            translation="[80, 210]"
            numRows="4"
            itemSize="[1000, 118]"
            itemSpacing="[0, 8]"
            rowItemSize="[[1000, 110]]"
            showRowLabel="[false]"
            drawFocusFeedback="true"
            itemComponentName="PrefRow"
            vertFocusAnimationStyle="floatingFocus"/>

        <Group translation="[1140, 210]">
            <Rectangle id="settingsPlate" width="700" height="680" />
            <Label
                id="settingsGuideTitle"
                translation="[36, 34]"
                width="628"
                height="90"
                wrap="true"
                text="Audio, made simple"
                font="font:MediumBoldSystemFont" />
            <Label
                id="settingsGuide"
                translation="[36, 150]"
                width="628"
                height="468"
                wrap="true"
                text="Choose TV / projector speakers or HDMI surround. Use Audio connection to see what Roku currently reports.">
                <Font role="font" uri="pkg:/fonts/OpenSans-Regular.ttf" size="24" />
            </Label>
        </Group>

        <Label
            id="settingsStatus"
            translation="[80, 940]"
            width="1760"
            height="70"
            wrap="true"
            font="font:SmallSystemFont" />
    </children>
</component>
