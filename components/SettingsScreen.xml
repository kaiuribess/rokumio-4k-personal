<?xml version="1.0" encoding="utf-8"?>
<component name="SettingsScreen" extends="Screen">
    <!-- Optional account sync and advanced external-server setup. The direct
         HTTPS playback route needs no external streaming server. -->
    <interface>
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <field id="pushRequest" type="assocarray" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/SettingsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />

    <children>
        <Rectangle id="settingsBg" width="1920" height="1080" color="0x0" />

        <Label
            id="settingsTitle"
            translation="[80, 48]"
            width="1760"
            height="70"
            text="Settings"
            font="font:LargeBoldSystemFont" />
        <Label
            id="settingsSub"
            translation="[80, 128]"
            width="1760"
            height="40"
            text="OK opens an option · Back returns to Home"
            font="font:SmallSystemFont" />

        <RowList
            id="settingsList"
            translation="[80, 210]"
            numRows="4"
            itemSize="[1000, 118]"
            itemSpacing="[0, 8]"
            rowItemSize="[[1000, 110]]"
            showRowLabel="[false]"
            drawFocusFeedback="true"
            itemComponentName="PrefRow"
            vertFocusAnimationStyle="floatingFocus"/>

        <Group translation="[1140, 210]">
            <Rectangle id="settingsPlate" width="700" height="620" />
            <Label
                id="settingsGuideTitle"
                translation="[36, 34]"
                width="628"
                height="90"
                wrap="true"
                text="Simple daily playback"
                font="font:MediumBoldSystemFont" />
            <Label
                id="settingsGuide"
                translation="[36, 150]"
                width="628"
                height="420"
                wrap="true"
                text="English audio only. Untagged or foreign-only tracks are rejected. Your source stays saved.&#10;&#10;Projector: AAC/PCM/MP3 audio. Known Dolby/DTS-only source labels are hidden. Keep Roku Audio output on Stereo.&#10;&#10;AX700: English DD/DD+ permitted. Roku to soundbar HDMI IN; HDMI OUT to projector.&#10;&#10;The app cannot convert audio. Source labels are hints; playback checks Roku track metadata."
                font="font:SmallSystemFont" />
        </Group>

        <Label
            id="settingsStatus"
            translation="[80, 940]"
            width="1760"
            height="70"
            wrap="true"
            font="font:SmallSystemFont" />
    </children>
</component>
