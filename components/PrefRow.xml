<?xml version="1.0" encoding="utf-8"?>
<component name="PrefRow" extends="Group">
    <!-- Wide focusable row used by the Settings and Add-ons lists. RowList
         drives it through the same read-only interface fields as every tile
         (itemContent / itemHasFocus / rowHasFocus). The row reads
         itemContent.title (left, bold) and itemContent.description (right,
         muted). -->
    <interface>
        <field id="itemContent" type="node" />
        <field id="itemHasFocus" type="boolean" />
        <field id="rowHasFocus" type="boolean" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/PrefRow.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />

    <children>
        <Rectangle id="rowFace" width="992" height="102" translation="[4, 4]" />
        <Label
            id="rowTitle"
            width="600"
            height="110"
            translation="[24, 0]"
            horizAlign="left"
            vertAlign="center"
            font="font:MediumBoldSystemFont" />
        <Label
            id="rowValue"
            width="336"
            height="110"
            translation="[640, 0]"
            horizAlign="right"
            vertAlign="center"
            font="font:MediumSystemFont" />
    </children>
</component>
